@article{candela_marginalidad_2020,
  abbr={REP},
  bibtex_show={true},
  title={Marginalidad, precariedad, indianización y middle ground en el Paraguay de la conquista 1526-1575},
  author={Candela, Guillaume},
  journal={Revista Estudios Paraguayos},
  address={Asunción, Paraguay},
  publisher={CEADUC},
  volume={38},
